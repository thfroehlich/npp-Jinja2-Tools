    "protocolVersion",
    "requestId",
    "success",
    "diagnostics",
    "result"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "success": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array"
    },
    "result": {}
  }
}