{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocolVersion",
    "requestId",
    "operation",
    "document"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "ping",
        "validate",
        "format",
        "analyze",
        "shutdown"
      ]
    },
    "document": {
      "type": "object",
      "required": [
        "name",
        "text"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}